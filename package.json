{
  "name": "pi-pstack",
  "version": "0.15.5-pi.1",
  "description": "if you want to go fast, go deep first. pstack helps you write less, but higher quality code. rigorous agent workflows you can parallelize with confidence.",
  "type": "module",
  "license": "MIT",
  "author": "Lauren Tan (pstack for Cursor); Pi port by just-joshn",
  "homepage": "https://github.com/just-joshn/pi-pstack",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/just-joshn/pi-pstack.git"
  },
  "keywords": [
    "pi-package",
    "pstack",
    "poteto-mode",
    "workflow",
    "principles",
    "agent-style",
    "subagents",
    "unslop"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "extensions/**/*.ts",
    "extensions/**/*.mjs",
    "extensions/**/*.js",
    "!extensions/**/*.test.ts",
    "skills",
    "agents",
    "docs",
    "automations",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/pstack-agents/index.ts",
      "./extensions/pstack-guards.ts",
      "./extensions/pstack-mode.ts",
      "./extensions/questionnaire.ts",
      "./extensions/todo.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "env -u PSTACK_AGENTS_DEPTH -u PSTACK_AGENTS_AGENT -u PSTACK_AGENTS_RUN_ID -u PSTACK_AGENTS_NESTING_ALLOWED -u PSTACK_AGENTS_PARENT_RUN_DIRECTORY -u PSTACK_AGENTS_PARENT_RUN_ATTEMPT bun test extensions parity/probes",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "parity": "node parity/check-parity.mjs && node parity/full-audit.mjs",
    "lint:package": "node parity/lint-package.mjs",
    "check": "npm run typecheck && npm test && npm run parity && npm run lint:package && node parity/provenance.mjs"
  },
  "dependencies": {
    "commander": "14.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "typebox": "1.3.27",
    "@types/node": "^24.13.5",
    "bun-types": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
