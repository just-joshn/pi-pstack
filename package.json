{
  "name": "pi-pstack-workflow-kit",
  "version": "0.1.1",
  "description": "Map-driven pstack and Team Kit workflows for Pi",
  "keywords": [
    "pi-package"
  ],
  "homepage": "https://github.com/just-joshn/pi-pstack/tree/feature/pi-native-workflow-kit#readme",
  "bugs": {
    "url": "https://github.com/just-joshn/pi-pstack/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/just-joshn/pi-pstack.git"
  },
  "files": [
    "agents",
    "extensions",
    "lib",
    "reference",
    "scripts/job-input.ts",
    "scripts/run-job.mjs",
    "skills"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "fix": "bun run lint:fix && bun run format"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "tsrs": "7.1.0-beta.tsrs5",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "extensions/index.ts"
    ],
    "skills": [
      "skills"
    ]
  }
}
