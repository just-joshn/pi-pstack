{
  "name": "pi-pstack-workflow-kit",
  "version": "0.3.0",
  "description": "Map-driven pstack and Team Kit workflows for Pi",
  "keywords": [
    "pi-package"
  ],
  "homepage": "https://github.com/just-joshn/pi-pstack#readme",
  "bugs": {
    "url": "https://github.com/just-joshn/pi-pstack/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/just-joshn/pi-pstack.git"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test:coverage"
  },
  "devDependencies": {
    "@types/node": "22",
    "@vitest/coverage-v8": "^5.1.1",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "tsrs": "7.1.0-beta.tsrs5",
    "typescript": "6",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "src/index.ts"
    ],
    "skills": [
      "src/skills"
    ]
  }
}
