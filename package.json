{
  "name": "pi-pstack",
  "version": "0.15.2-pi.0",
  "description": "Local Pi twin of Cursor pstack v0.15.2 (max practical parity; see PARITY.md behavioral scorecard).",
  "type": "module",
  "engines": {
    "bun": ">=1.0.0"
  },
  "license": "MIT",
  "author": "Lauren Tan (original pstack); Pi port contributors (@just-joshn)",
  "homepage": "https://github.com/cursor/plugins/tree/main/pstack",
  "keywords": [
    "pi-package",
    "pstack",
    "poteto-mode",
    "agent-skills",
    "workflow",
    "subagents",
    "unslop"
  ],
  "files": [
    "extensions",
    "skills",
    "agents",
    "docs",
    "automations",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "PARITY.md",
    "assets",
    ".gitignore"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "npm run typecheck && node compat/check.mjs && node spec/spec-check.mjs && node tests/conformance.mjs && vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "compat:generate": "node compat/generate.mjs",
    "compat:check": "node compat/check.mjs",
    "compat:report": "node compat/report.mjs",
    "compat:gate": "node compat/check.mjs && node compat/report.mjs --check && node spec/spec-check.mjs --require-complete && npm run test:differential && npm test && npm run parity:check",
    "spec:check": "node spec/spec-check.mjs",
    "spec:gate": "node spec/spec-check.mjs --require-complete && npm test && npm run parity:check && npm run test:differential && npm run test:acceptance && npm run test:coverage",
    "test:differential": "vitest run --config vitest.opt-in.config.ts --project differential",
    "test:acceptance": "vitest run --project acceptance",
    "test:journeys": "vitest run --project user-journeys",
    "test:coverage": "vitest run --coverage",
    "test:conformance": "node tests/conformance.mjs",
    "test:bootstrap": "node tests/support/link-peers.mjs",
    "test:unit": "vitest run --project unit",
    "test:hosted": "vitest run --project hosted",
    "test:integration": "vitest run --project integration",
    "test:inventory": "vitest run --project inventory",
    "test:smoke": "vitest run --project smoke",
    "test:reload": "vitest run --project reload",
    "test:rpc": "vitest run --project rpc",
    "test:tui": "vitest run --project tui",
    "test:extensions": "vitest run --project extensions",
    "test:third-party": "vitest run --config vitest.opt-in.config.ts --project third-party",
    "test:scripts": "vitest run --project scripts",
    "test:audit": "vitest run --config vitest.opt-in.config.ts --project audit",
    "test:list": "vitest list",
    "parity:check": "node port/port.mjs check && node port/contract.mjs && node port/alias.mjs",
    "drift:report": "node port/drift.mjs report",
    "parity:sync": "node port/port.mjs sync",
    "conformance": "node tests/conformance.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@vitest/coverage-v8": "^5.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
