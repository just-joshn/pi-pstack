{
  "name": "pi-pstack",
  "version": "0.15.2-pi.1",
  "description": "if you want to go fast, go deep first. pstack helps you write less, but higher quality code. rigorous agent workflows you can parallelize with confidence.",
  "type": "module",
  "engines": {
    "bun": ">=1.0.0"
  },
  "license": "MIT",
  "author": "Lauren Tan (original pstack); Pi port contributors (@just-joshn)",
  "homepage": "https://github.com/cursor/plugins/tree/main/pstack",
  "keywords": [
    "pi-package",
    "pstack",
    "poteto-mode",
    "workflow",
    "principles",
    "agent-style",
    "subagents",
    "unslop"
  ],
  "category": "developer-tools",
  "files": [
    "extensions",
    "skills",
    "agents",
    "docs",
    "automations",
    "README.md",
    "LICENSE",
    "NOTICE",
    "assets",
    ".gitignore"
  ],
  "pi": {
    "extensions": [
      "./extensions/subagent/index.ts",
      "./extensions/pstack-slash.ts",
      "./extensions/todo.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "node tests/run-check-port.mjs && node tests/conformance.mjs && vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "check-port": "node tests/run-check-port.mjs",
    "native-parity": "node tests/native-parity.mjs",
    "conformance": "node tests/conformance.mjs",
    "test:unit": "vitest run --project unit",
    "test:scripts": "bun test skills/poteto-mode/scripts",
    "test:list": "vitest list"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
