{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  "plugins": ["eslint", "typescript", "unicorn", "oxc", "node"],

  "env": {
    "builtin": true,
    "node": true,
    "browser": false
  },

  "options": {
    "typeAware": true,
    "typeCheck": false,
    "reportUnusedDisableDirectives": "error"
  },

  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "pedantic": "off",
    "restriction": "off",
    "style": "off",
    "nursery": "off"
  },

  "rules": {
    "eslint/no-unused-vars": [
      "error",
      {
        "args": "all",
        "argsIgnorePattern": "^_",
        "caughtErrors": "all",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],

    "eslint/eqeqeq": "error",
    "eslint/prefer-const": "error",
    "eslint/no-console": "error",
    "eslint/max-lines": ["error", { "max": 799, "skipBlankLines": false, "skipComments": false }],
    "eslint/max-lines-per-function": [
      "error",
      { "max": 49, "skipBlankLines": false, "skipComments": false, "IIFEs": true }
    ],
    "eslint/max-depth": ["error", { "max": 4 }],
    "eslint/no-debugger": "error",
    "eslint/no-eval": "error",

    "eslint/no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["bun", "bun:*"],
            "message": "Pi extensions run on Node.js. Use Node.js APIs."
          }
        ]
      }
    ],

    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-require-imports": "error",

    "typescript/no-floating-promises": [
      "error",
      {
        "ignoreVoid": false,
        "checkThenables": true
      }
    ],

    "typescript/no-misused-promises": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/switch-exhaustiveness-check": "error",

    "unicorn/prefer-node-protocol": "error",
    "unicorn/no-process-exit": "error"
  },

  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "src/skills/*/scripts/**",
    "src/skills/pr-review-canvas/**"
  ]
}
