strict digraph DiskGraph {
nodesep=0.35;
subgraph cluster_graph {
color="white";
-1 [label="x = 0\n/\\ ok = TRUE\n/\\ color = \"red\"\n/\\ seen = {1, 2}\n/\\ tags = {\"a\", \"b\"}\n/\\ rec = [a |-> 1, b |-> {2}]\n/\\ tup = <<1, \"x\">>\n/\\ pairs = (\"a\" :> 1 @@ \"b\" :> 2)\n/\\ range = 1..3",style = filled]
-1 -> -2 [label="Next",color="black",fontcolor="black"];
-2 [label="x = 1\n/\\ ok = FALSE\n/\\ color = \"blue\"\n/\\ seen = {1, 2, 3}\n/\\ tags = {\"a\", \"b\"}\n/\\ rec = [a |-> 2, b |-> {3}]\n/\\ tup = <<2, \"y\">>\n/\\ pairs = (\"a\" :> 2 @@ \"b\" :> 1)\n/\\ range = 0..3"];
{rank = same; -1;}
{rank = same; -2;}
}
}
